name: Auto Merge Pull Requests

on:
  pull_request:
    types: [opened, reopened, synchronize]
  pull_request_review:
    types: [submitted]
  status: {}

jobs:
  auto-merge:
    runs-on: ubuntu-latest
    
    permissions:
      pull-requests: write
      contents: write
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Enable auto-merge
        uses: pascalgn/automerge-action@v0.16.2
        with:
          args: "--add-label automerged"
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          MERGE_METHOD: squash
          MERGE_COMMIT_MESSAGE: auto
          MERGE_FUSE_COMMITS: false
          UPDATE_METHOD: rebase
